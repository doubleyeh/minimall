.tabs {
  display: flex;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs__item {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: var(--text-2);
  position: relative;
}

.tabs__item--active {
  color: var(--brand);
  font-weight: 600;
}

.tabs__item--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 4rpx;
  margin-left: -24rpx;
  background: var(--brand);
  border-radius: 2rpx;
}

.order {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.order__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--bg-soft);
}

.order__no {
  font-size: 24rpx;
  color: var(--text-2);
}

.order__status {
  font-size: 26rpx;
  color: var(--brand);
}

.line {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.line__img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.line__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.line__name {
  font-size: 27rpx;
  line-height: 1.4;
}

.line__sku {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.line__amount {
  font-size: 26rpx;
  margin-left: 12rpx;
}

.order__foot {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--bg-soft);
  font-size: 26rpx;
}

.order__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn {
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 62rpx;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 32rpx;
}

.btn--primary {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}

.empty {
  padding: 180rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 28rpx;
}

.tip {
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
