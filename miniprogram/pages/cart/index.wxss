.empty {
  padding: 160rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 28rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
}

/* 失效条目整体压暗,但仍然显示:直接隐藏会让用户以为"少了一件" */
.item--invalid {
  opacity: 0.55;
}

.item__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.item__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item__name {
  font-size: 28rpx;
  line-height: 1.4;
}

.item__sku {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.item__invalid {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--price);
}

.item__foot {
  margin-top: 12rpx;
}

.item__remove {
  padding: 12rpx 0 12rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-3);
  align-self: flex-start;
}

/* 勾选框自己画:小程序没有原生 checkbox 的样式自由度,而这里只有两种状态 */
.check {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--line-strong);
  border-radius: 50%;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.check--on {
  background: var(--brand);
  border-color: var(--brand);
}

.check--off {
  background: var(--bg-soft);
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper__btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-2);
  background: var(--bg-soft);
  border-radius: 8rpx;
}

.stepper__btn--off {
  color: var(--line-strong);
}

.stepper__value {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.clear-row {
  padding: 32rpx 24rpx;
  text-align: center;
}

.clear-row__link {
  font-size: 26rpx;
  color: var(--text-2);
}

.action-bar__label {
  font-size: 26rpx;
  color: var(--text-2);
}

.action-bar__total {
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
  font-size: 26rpx;
}

.action-bar__btn {
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  background: var(--brand);
  color: #ffffff;
}
