<view class="page page-with-action-bar">
  <view class="card">
    <view class="section-title">评分</view>
    <view class="stars">
      <text
        wx:for="{{starList}}"
        wx:key="value"
        class="star {{item.on ? 'star--on' : ''}}"
        bindtap="onStarTap"
        data-value="{{item.value}}"
      >{{item.char}}</text>
    </view>
    <view class="text-muted">{{rating}} 分</view>
  </view>

  <view class="card">
    <view class="section-title">评价内容</view>
    <textarea
      class="textarea"
      value="{{content}}"
      placeholder="说说这次购物体验(选填)"
      maxlength="500"
      bindinput="onContentInput"
    ></textarea>
  </view>

  <view class="card row-between">
    <text>匿名评价</text>
    <switch checked="{{anonymous}}" color="#FF4D1C" bindchange="onAnonymousChange" />
  </view>

  <view class="card">
    <view class="section-title">晒图(选填,最多 {{imageMax}} 张)</view>
    <view class="img-picker">
      <view wx:for="{{images}}" wx:key="*this" class="img-picker__item">
        <image
          class="img-picker__img"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="onPreviewImage"
        />
        <view class="img-picker__del" data-index="{{index}}" catchtap="onRemoveImage">×</view>
      </view>
      <view
        wx:if="{{images.length < imageMax}}"
        class="img-picker__add"
        bindtap="onAddImage"
      >{{uploading ? '···' : '+'}}</view>
    </view>
  </view>
</view>

<view class="action-bar">
  <view class="action-bar__btn {{submitting ? 'action-bar__btn--off' : ''}}" bindtap="onSubmit">提交评价</view>
</view>
