.page {
  padding-bottom: 180rpx;
}

.address {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.address__line {
  display: flex;
  align-items: baseline;
}

.address__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.address__phone {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.address__detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 38rpx;
}

.address__empty {
  font-size: 28rpx;
  color: var(--brand);
}

.goods {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.goods__img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--brand-soft);
}

.goods__body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods__name {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 38rpx;
}

.goods__sku {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.goods__row {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods__price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--price);
}

.goods__yuan {
  font-size: 22rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper__btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 30rpx;
  color: var(--text-1);
}

.stepper__value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}

.amounts {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.amounts__row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 52rpx;
}

.amounts__tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.footer__left {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.footer__label {
  font-size: 24rpx;
  color: var(--text-2);
}

.footer__pay {
  margin-left: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--price);
}

.footer__yuan {
  font-size: 24rpx;
}

.footer__btn {
  width: 300rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: linear-gradient(90deg, var(--brand), var(--brand-deep));
  border: none;
}
