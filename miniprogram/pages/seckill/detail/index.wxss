.page {
  padding-bottom: 160rpx;
}

.hero {
  position: relative;
  width: 100%;
  height: 560rpx;
  background: var(--brand-soft);
}

.hero__img {
  width: 100%;
  height: 100%;
}

.hero__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__flag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: var(--brand);
  border-radius: 30rpx;
}

.hero__countdown {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

.panel {
  margin: -24rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  position: relative;
}

.prices {
  display: flex;
  align-items: baseline;
}

.prices__now {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--price);
}

.prices__yuan {
  font-size: 28rpx;
}

.prices__original {
  margin-left: 14rpx;
  font-size: 26rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

.prices__remain {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--brand);
}

.prices__remain--off {
  color: var(--text-3);
}

.progress {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.progress__bar {
  flex: 1;
  height: 14rpx;
  border-radius: 7rpx;
  background: var(--brand-soft);
  overflow: hidden;
}

.progress__in {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-deep));
}

.progress__text {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 44rpx;
}

.sku {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.limit {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.rules {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.rules__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 10rpx;
}

.rules__line {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 40rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.footer__btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #ffffff;
  background: linear-gradient(90deg, var(--brand), var(--brand-deep));
  border: none;
}

.footer__btn--off {
  background: var(--brand-disabled);
}
