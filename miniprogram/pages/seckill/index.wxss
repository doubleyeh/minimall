.section-title {
  padding: 28rpx 24rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.card {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card__img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--brand-soft);
}

.card__body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.card__name {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 38rpx;
}

.card__prices {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
}

.card__price {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--price);
}

.card__yuan {
  font-size: 24rpx;
}

.card__original {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

.card__progress {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.card__bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--brand-soft);
  overflow: hidden;
}

.card__bar-in {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--brand-deep));
}

.card__percent {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.card__countdown {
  margin-top: auto;
  padding-top: 12rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.card__countdown--off {
  color: var(--text-3);
}

.card__countdown--soon {
  color: var(--text-2);
}
