.page {
  padding: 20rpx 24rpx 0;
}

/* ---------------- 收货地址 ---------------- */

.addr {
  position: relative;
  padding-right: 60rpx;
}

.addr__head {
  display: flex;
  align-items: center;
}

.addr__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.addr__phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.addr__detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-2);
}

.addr__empty {
  font-size: 28rpx;
  color: var(--text-3);
}

.addr__arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: var(--text-3);
}

/* ---------------- 商品行 ---------------- */

.line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.line + .line {
  border-top: 1rpx solid var(--line);
}

.line__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.line__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.line__name {
  font-size: 27rpx;
  line-height: 1.4;
  color: var(--text);
}

.line__sku {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.line__right {
  margin-left: 16rpx;
  text-align: right;
  flex-shrink: 0;
}

.line__price {
  display: block;
  font-size: 27rpx;
  color: var(--text);
}

.line__qty {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------------- 表单行 ---------------- */

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field--last {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.field__label {
  font-size: 28rpx;
  color: var(--text);
}

.field__stack {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.field__hint {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.field__value-wrap {
  display: flex;
  align-items: center;
  max-width: 60%;
}

.field__value {
  font-size: 26rpx;
  color: var(--text-2);
}

.field__arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: var(--text-3);
}

.field__input {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: var(--text);
}

/* ---------------- 金额明细 ---------------- */

.amount-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.amount-line__label {
  font-size: 26rpx;
  color: var(--text-2);
}

.amount-line__value {
  font-size: 26rpx;
  color: var(--text);
}

.amount-line--total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.amount-line--total .amount-line__label {
  font-size: 28rpx;
  color: var(--text);
}

.action-bar__total-label {
  margin-right: 8rpx;
  font-size: 25rpx;
  color: var(--text-2);
}
