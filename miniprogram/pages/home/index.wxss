.page {
  padding-bottom: 24rpx;
}

/* 搜索入口。这里不做真搜索框,点进搜索页再输入 —— 首页少一个输入焦点,滚动更顺 */
.search {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin: 20rpx 24rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 36rpx;
}

.search__icon {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-right: 12rpx;
}

.search__placeholder {
  font-size: 26rpx;
  color: #b0b0b0;
}

/* 分类横滑。white-space: nowrap 是 scroll-view 横滑生效的关键,漏了会换行 */
.cats {
  white-space: nowrap;
  padding: 0 12rpx;
}

.cats__item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 12rpx;
  font-size: 26rpx;
  color: #4b4b4b;
  background: #ffffff;
  border-radius: 32rpx;
}

.cats__item--active {
  color: #ffffff;
  background: #0052d9;
}

.goods {
  padding: 12rpx 24rpx 0;
}

.goods__card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.goods__image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  /* 图片没加载出来时是这个底色,而不是一条白缝 */
  background: #f0f0f0;
  flex-shrink: 0;
}

.goods__body {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.goods__name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.goods__subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8a;
}

.goods__foot {
  margin-top: 12rpx;
}

.price__suffix {
  font-size: 22rpx;
  color: #e34d59;
  margin-left: 4rpx;
}

.tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}
