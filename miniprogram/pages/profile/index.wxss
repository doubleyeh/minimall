.header {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: var(--brand-grad);
}

.header__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #ffffff;
  flex-shrink: 0;
}

.header__avatar--placeholder {
  color: var(--brand);
  font-size: 56rpx;
  font-weight: 600;
  line-height: 128rpx;
  text-align: center;
}

.header__body {
  margin-left: 28rpx;
  color: #ffffff;
}

.header__name {
  font-size: 34rpx;
  font-weight: 600;
}

.header__edit {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
}

.header__stats {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.header__dot {
  margin: 0 10rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.section-title__more {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-2);
}

.counts {
  display: flex;
}

.counts__item {
  flex: 1;
  text-align: center;
}

.counts__value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brand);
}

.counts__label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.entries {
  padding: 0 24rpx;
}

.entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--bg-soft);
}

.entry:last-child {
  border-bottom: none;
}

.entry__arrow {
  color: var(--line-strong);
}

.fail {
  padding: 24rpx;
  text-align: center;
}
