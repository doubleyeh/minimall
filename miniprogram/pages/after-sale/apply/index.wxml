<view class="page page-with-action-bar">
  <view class="card">
    <view class="section-title">售后类型</view>
    <view class="chips">
      <view
        wx:for="{{types}}"
        wx:key="value"
        class="chip {{item.value === afterSaleType ? 'chip--active' : ''}}"
        bindtap="onTypeTap"
        data-value="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">退款金额</view>
    <input
      class="input"
      type="digit"
      value="{{refundAmount}}"
      placeholder="不超过该商品实付金额"
      bindinput="onAmountInput"
    />
  </view>

  <view class="card">
    <view class="section-title">申请原因</view>
    <input
      class="input"
      value="{{applyReason}}"
      placeholder="例如:商品有破损"
      maxlength="50"
      bindinput="onReasonInput"
    />
    <textarea
      class="textarea"
      value="{{applyDesc}}"
      placeholder="补充说明(选填)"
      maxlength="200"
      bindinput="onDescInput"
    ></textarea>
  </view>

  <view class="card">
    <view class="section-title">凭证图片(选填,最多 {{imageMax}} 张)</view>
    <view class="img-picker">
      <view wx:for="{{images}}" wx:key="*this" class="img-picker__item">
        <image
          class="img-picker__img"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="onPreviewImage"
        />
        <view class="img-picker__del" data-index="{{index}}" catchtap="onRemoveImage">×</view>
      </view>
      <view
        wx:if="{{images.length < imageMax}}"
        class="img-picker__add"
        bindtap="onAddImage"
      >{{uploading ? '···' : '+'}}</view>
    </view>
  </view>
</view>

<view class="action-bar">
  <view class="action-bar__btn {{submitting ? 'action-bar__btn--off' : ''}}" bindtap="onSubmit">提交申请</view>
</view>
