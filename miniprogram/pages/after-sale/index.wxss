.empty {
  padding: 180rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 28rpx;
}

.as {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.as__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--bg-soft);
}

.as__no {
  font-size: 24rpx;
  color: var(--text-2);
}

.as__status {
  font-size: 26rpx;
  color: var(--brand);
}

.as__body {
  display: flex;
  padding: 20rpx 0;
}

.as__img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.as__info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.as__name {
  font-size: 27rpx;
  line-height: 1.4;
}

.as__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.as__reason {
  font-size: 25rpx;
  color: var(--text-2);
}

.as__reject {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: var(--price);
  background: var(--brand-soft);
  border-radius: 8rpx;
}

.as__time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.as__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.btn {
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 62rpx;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 32rpx;
}

.btn--primary {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}
