.status-card {
  padding: 48rpx 32rpx;
  background: var(--brand-grad);
  color: #ffffff;
}

.status-card__text {
  font-size: 40rpx;
  font-weight: 600;
}

.status-card__tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.line-text {
  font-size: 26rpx;
  line-height: 1.6;
}

.line {
  display: flex;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--bg-soft);
}

.line__img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.line__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.line__name {
  font-size: 27rpx;
  line-height: 1.4;
}

.line__sku {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.line__after {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand);
}

.line__right {
  text-align: right;
  margin-left: 12rpx;
}

.line__amount {
  font-size: 26rpx;
}

.amount-line {
  padding: 10rpx 0;
  font-size: 26rpx;
}

.amount-line--total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--bg-soft);
  font-weight: 600;
}

.btn {
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 70rpx;
  margin-left: 16rpx;
  font-size: 27rpx;
  color: var(--text-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 36rpx;
}

.btn--primary {
  color: #ffffff;
  background: var(--brand);
  border-color: var(--brand);
}

.btn--small {
  margin: 12rpx 0 0;
  height: 52rpx;
  line-height: 50rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.fail {
  padding: 160rpx 48rpx;
  text-align: center;
  color: var(--text-2);
  font-size: 28rpx;
}
