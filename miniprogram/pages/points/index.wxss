.page {
  padding: 12rpx 24rpx 0;
}

.log {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.log__body {
  flex: 1;
  min-width: 0;
}

.log__reason {
  font-size: 28rpx;
  color: var(--text);
}

.log__remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.log__time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.log__right {
  margin-left: 20rpx;
  text-align: right;
  flex-shrink: 0;
}

.log__change {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* 获得用品牌色,消耗用中性色 —— 只靠正负号在小字下不容易一眼分辨 */
.log__change--gain {
  color: var(--price);
}

.log__balance {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
