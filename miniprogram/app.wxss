/*
 * 全局样式。
 *
 * 不需要引入组件库主题:tdesign-miniprogram 每个组件的 wxss 自己会
 * `@import '../common/style/index.wxss'`(见 node_modules 下 button/button.wxss),
 * 所以在 app.wxss 里再引一次是多余的,还会让样式体积翻倍。
 */

page {
  background: #f5f5f5;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-muted {
  color: #8a8a8a;
  font-size: 24rpx;
}

/* 价格:符号与数字不同字号,避免大数字把小数字顶得很大 */
.price {
  color: #e34d59;
  font-weight: 600;
}

.price__symbol {
  font-size: 22rpx;
}

.price__value {
  font-size: 36rpx;
}

.price--origin {
  color: #999999;
  font-size: 24rpx;
  font-weight: 400;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 两行截断:小程序里没有 CSS 的 line-clamp 简写,必须四件套一起写 */
.ellipsis-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 底部固定操作条:详情页、结算页、购物车都用它,统一留出安全区 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

/* 有底部操作条的页面给内容留出空间,否则最后一行会被盖住 */
.page-with-action-bar {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.empty-block {
  padding: 120rpx 0;
}
